{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "cjt/paginakop",
	"title": "Paginakop",
	"category": "creajt-starter",
	"description": "De opening van een binnenpagina: een regeltje erboven, de titel en een korte intro.",
	"textdomain": "creajt-starter",
	"supports": { "html": false, "multiple": false },
	"attributes": {
		"boven": { "type": "string", "default": "", "role": "content" },
		"titel": { "type": "string", "default": "", "role": "content" },
		"intro": { "type": "string", "default": "", "role": "content" }
	}
}
