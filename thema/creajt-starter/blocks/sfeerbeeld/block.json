{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "cjt/sfeerbeeld",
	"title": "Sfeerbeeld",
	"category": "creajt-starter",
	"description": "Een foto over de volle breedte, met een bijschrift eronder.",
	"textdomain": "creajt-starter",
	"supports": { "html": false, "align": [ "wide", "full" ] },
	"attributes": {
		"url": { "type": "string", "default": "", "role": "content" },
		"alt": { "type": "string", "default": "", "role": "content" },
		"bijschrift": { "type": "string", "default": "", "role": "content" },
		"hoogte": { "type": "string", "default": "normaal", "enum": [ "laag", "normaal", "hoog" ] },
		"align": { "type": "string", "default": "full" }
	}
}
