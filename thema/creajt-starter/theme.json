{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "780px",
			"wideSize": "1240px"
		},
		"color": {
			"custom": false,
			"customDuotone": false,
			"customGradient": false,
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"palette": [
				{ "slug": "basis", "color": "#f6f4f1", "name": "Basis (achtergrond)" },
				{ "slug": "zacht", "color": "#e7e2db", "name": "Zacht (tweede vlak)" },
				{ "slug": "lijn", "color": "#cfc8bf", "name": "Lijn (randen en vlakken)" },
				{ "slug": "merk", "color": "#2f3a34", "name": "Merkkleur (uit het logo)" },
				{ "slug": "inkt", "color": "#1d241f", "name": "Inkt (diepste toon)" },
				{ "slug": "gedempt", "color": "#56604f", "name": "Gedempt (bijschriften)" },
				{ "slug": "accent", "color": "#6e6045", "name": "Accent (spaarzaam)" },
				{ "slug": "wit", "color": "#ffffff", "name": "Wit" }
			]
		},
		"typography": {
			"customFontSize": false,
			"defaultFontSizes": false,
			"dropCap": false,
			"fluid": false,
			"writingMode": false,
			"fontFamilies": [
				{
					"slug": "kop",
					"name": "Koppen",
					"fontFamily": "Kopletter, \"Cormorant Garamond\", \"Big Caslon\", Georgia, \"Times New Roman\", serif"
				},
				{
					"slug": "tekst",
					"name": "Lopende tekst",
					"fontFamily": "Tekstletter, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Helvetica, Arial, sans-serif"
				}
			],
			"fontSizes": [
				{ "slug": "x-small", "size": "0.8125rem", "name": "Piepklein (label)" },
				{ "slug": "small", "size": "0.875rem", "name": "Klein" },
				{ "slug": "medium", "size": "clamp(1rem, 0.97rem + 0.12vw, 1.0625rem)", "name": "Lopende tekst" },
				{ "slug": "large", "size": "clamp(1.15rem, 1.05rem + 0.4vw, 1.4rem)", "name": "Tussenkop" },
				{ "slug": "x-large", "size": "clamp(1.5rem, 1.2rem + 1.05vw, 2.1rem)", "name": "Sectiekop" },
				{ "slug": "xx-large", "size": "clamp(1.7rem, 1.35rem + 1.4vw, 2.5rem)", "name": "Paginakop" },
				{ "slug": "hero", "size": "clamp(2.2rem, 1.6rem + 2.4vw, 3.6rem)", "name": "Hero" }
			]
		},
		"spacing": {
			"customSpacingSize": false,
			"defaultSpacingSizes": false,
			"units": [ "px", "rem", "vh", "vw", "%" ],
			"spacingSizes": [
				{ "slug": "10", "size": "0.5rem", "name": "1 heel klein" },
				{ "slug": "20", "size": "1rem", "name": "2 klein" },
				{ "slug": "30", "size": "2rem", "name": "3 middel" },
				{ "slug": "40", "size": "3rem", "name": "4 groot" },
				{ "slug": "50", "size": "clamp(2.75rem, 5vw, 4.5rem)", "name": "5 heel groot" },
				{ "slug": "60", "size": "clamp(3.5rem, 7vw, 6rem)", "name": "6 ruimte tussen secties" }
			]
		},
		"border": { "color": true, "radius": true, "style": true, "width": true },
		"shadow": { "defaultPresets": false },
		"custom": {
			"tracking": { "caps": "0.18em", "button": "0.12em", "display": "0.005em" },
			"leading": { "tight": "1.06", "kop": "1.14", "body": "1.7" },
			"radius": "0px",
			"ease": "cubic-bezier(0.16, 1, 0.3, 1)",
			"duration": { "base": "500ms", "slow": "1100ms" },
			"line": "rgba(47, 58, 52, 0.16)",
			"lineLicht": "rgba(231, 226, 219, 0.22)"
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--basis)",
			"text": "var(--wp--preset--color--merk)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--tekst)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "var(--wp--custom--leading--body)",
			"letterSpacing": "0.005em"
		},
		"spacing": {
			"blockGap": "var(--wp--preset--spacing--30)",
			"padding": {
				"left": "var(--wp--preset--spacing--30)",
				"right": "var(--wp--preset--spacing--30)"
			}
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--kop)",
					"fontWeight": "300",
					"lineHeight": "var(--wp--custom--leading--kop)",
					"letterSpacing": "var(--wp--custom--tracking--display)"
				},
				"color": { "text": "var(--wp--preset--color--merk)" }
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)",
					"lineHeight": "var(--wp--custom--leading--tight)"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)",
					"lineHeight": "var(--wp--custom--leading--tight)"
				}
			},
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
			"link": {
				"color": { "text": "var(--wp--preset--color--merk)" },
				"typography": { "textDecoration": "underline" },
				":hover": { "typography": { "textDecoration": "none" } }
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--merk)",
					"text": "var(--wp--preset--color--basis)"
				},
				"border": { "radius": "0px" },
				"spacing": {
					"padding": { "top": "1.15rem", "bottom": "1.15rem", "left": "2.4rem", "right": "2.4rem" }
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--tekst)",
					"fontSize": "var(--wp--preset--font-size--x-small)",
					"letterSpacing": "var(--wp--custom--tracking--button)",
					"textTransform": "uppercase",
					"textDecoration": "none",
					"lineHeight": "1",
					"fontWeight": "500"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--gedempt)",
						"text": "var(--wp--preset--color--basis)"
					}
				},
				":focus": {
					"color": {
						"background": "var(--wp--preset--color--gedempt)",
						"text": "var(--wp--preset--color--basis)"
					}
				}
			},
			"caption": {
				"typography": { "fontSize": "var(--wp--preset--font-size--small)" },
				"color": { "text": "var(--wp--preset--color--gedempt)" }
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--kop)",
					"fontSize": "var(--wp--preset--font-size--large)",
					"fontWeight": "300",
					"textTransform": "uppercase",
					"letterSpacing": "0.12em"
				}
			},
			"core/navigation": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-small)",
					"textTransform": "uppercase",
					"letterSpacing": "var(--wp--custom--tracking--caps)"
				},
				"elements": { "link": { "typography": { "textDecoration": "none" } } }
			},
			"core/quote": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--kop)",
					"fontSize": "var(--wp--preset--font-size--x-large)",
					"fontStyle": "italic",
					"fontWeight": "300",
					"lineHeight": "1.15"
				},
				"border": { "width": "0" }
			},
			"core/separator": { "color": { "text": "var(--wp--preset--color--accent)" } }
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	],
	"customTemplates": [
		{ "name": "page-breed", "title": "Pagina op volle breedte", "postTypes": [ "page" ] }
	]
}
