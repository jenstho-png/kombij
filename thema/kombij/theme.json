{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "760px",
			"wideSize": "1240px"
		},
		"color": {
			"custom": false,
			"customDuotone": false,
			"customGradient": false,
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"palette": [
				{ "slug": "wit", "color": "#ffffff", "name": "Wit" },
				{ "slug": "ijs", "color": "#f1f8fb", "name": "IJsblauw (zacht vlak)" },
				{ "slug": "glasblauw", "color": "#b0e1f1", "name": "Glasblauw (licht vlak)" },
				{ "slug": "zeegroen", "color": "#72b6bf", "name": "Zeegroen (lijnen en ornament, geen tekst)" },
				{ "slug": "helderblauw", "color": "#1e7cb2", "name": "Helderblauw (nadruk, alleen op wit)" },
				{ "slug": "kerkblauw", "color": "#1b5381", "name": "Kerkblauw (primair)" },
				{ "slug": "nachtblauw", "color": "#0a2444", "name": "Nachtblauw (tekst en donkere vlakken)" },
				{ "slug": "leisteen", "color": "#44566e", "name": "Leisteen (bijschriften)" }
			]
		},
		"typography": {
			"customFontSize": false,
			"defaultFontSizes": false,
			"dropCap": false,
			"fluid": false,
			"writingMode": false,
			"fontFamilies": [
				{
					"slug": "montserrat",
					"name": "Montserrat",
					"fontFamily": "Montserrat, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Helvetica, Arial, sans-serif"
				}
			],
			"fontSizes": [
				{ "slug": "x-small", "size": "0.8125rem", "name": "Label" },
				{ "slug": "small", "size": "0.9375rem", "name": "Klein" },
				{ "slug": "medium", "size": "clamp(1.0625rem, 1.02rem + 0.18vw, 1.125rem)", "name": "Lopende tekst" },
				{ "slug": "large", "size": "clamp(1.2rem, 1.1rem + 0.45vw, 1.45rem)", "name": "Tussenkop" },
				{ "slug": "x-large", "size": "clamp(1.6rem, 1.3rem + 1.2vw, 2.4rem)", "name": "Sectiekop" },
				{ "slug": "xx-large", "size": "clamp(1.9rem, 1.45rem + 1.9vw, 3.1rem)", "name": "Paginakop" },
				{ "slug": "hero", "size": "clamp(2.1rem, 1.5rem + 2.6vw, 3.9rem)", "name": "Hero" }
			]
		},
		"spacing": {
			"customSpacingSize": false,
			"defaultSpacingSizes": false,
			"units": [ "px", "rem", "vh", "vw", "%" ],
			"spacingSizes": [
				{ "slug": "10", "size": "0.5rem", "name": "1 heel klein" },
				{ "slug": "20", "size": "1rem", "name": "2 klein" },
				{ "slug": "30", "size": "clamp(1.25rem, 3vw, 2rem)", "name": "3 middel" },
				{ "slug": "40", "size": "clamp(2rem, 4vw, 3rem)", "name": "4 groot" },
				{ "slug": "50", "size": "clamp(2.75rem, 5vw, 4.5rem)", "name": "5 heel groot" },
				{ "slug": "60", "size": "clamp(3.75rem, 8vw, 7rem)", "name": "6 ruimte tussen secties" }
			]
		},
		"border": { "color": true, "radius": true, "style": true, "width": true },
		"shadow": { "defaultPresets": false },
		"custom": {
			"tracking": { "caps": "0.14em", "button": "0.02em", "display": "-0.015em" },
			"leading": { "tight": "1.12", "kop": "1.2", "body": "1.7" },
			"radius": "6px",
			"ease": "cubic-bezier(0.16, 1, 0.3, 1)",
			"duration": { "base": "400ms", "slow": "1000ms" },
			"line": "rgba(10, 36, 68, 0.12)",
			"lineLicht": "rgba(255, 255, 255, 0.18)"
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--wit)",
			"text": "var(--wp--preset--color--nachtblauw)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--montserrat)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"fontWeight": "500",
			"lineHeight": "var(--wp--custom--leading--body)"
		},
		"spacing": {
			"blockGap": "1.25rem",
			"padding": {
				"left": "var(--wp--preset--spacing--30)",
				"right": "var(--wp--preset--spacing--30)"
			}
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--montserrat)",
					"fontWeight": "700",
					"lineHeight": "var(--wp--custom--leading--kop)",
					"letterSpacing": "var(--wp--custom--tracking--display)"
				},
				"color": { "text": "var(--wp--preset--color--nachtblauw)" }
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)",
					"lineHeight": "var(--wp--custom--leading--tight)"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)",
					"lineHeight": "var(--wp--custom--leading--tight)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)",
					"fontWeight": "600"
				}
			},
			"link": {
				"color": { "text": "var(--wp--preset--color--kerkblauw)" },
				"typography": { "textDecoration": "underline" },
				":hover": { "typography": { "textDecoration": "none" } }
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--kerkblauw)",
					"text": "var(--wp--preset--color--wit)"
				},
				"border": { "radius": "999px" },
				"spacing": {
					"padding": { "top": "1rem", "bottom": "1rem", "left": "1.9rem", "right": "1.9rem" }
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--montserrat)",
					"fontSize": "1rem",
					"letterSpacing": "var(--wp--custom--tracking--button)",
					"textDecoration": "none",
					"lineHeight": "1.2",
					"fontWeight": "600"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--nachtblauw)",
						"text": "var(--wp--preset--color--wit)"
					}
				},
				":focus": {
					"color": {
						"background": "var(--wp--preset--color--nachtblauw)",
						"text": "var(--wp--preset--color--wit)"
					}
				}
			},
			"caption": {
				"typography": { "fontSize": "var(--wp--preset--font-size--small)" },
				"color": { "text": "var(--wp--preset--color--leisteen)" }
			}
		},
		"blocks": {
			"core/quote": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)",
					"fontWeight": "600",
					"lineHeight": "1.45"
				},
				"border": { "width": "0" }
			},
			"core/separator": { "color": { "text": "var(--wp--preset--color--zeegroen)" } }
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	],
	"customTemplates": [
		{ "name": "page-breed", "title": "Pagina op volle breedte", "postTypes": [ "page" ] }
	]
}
